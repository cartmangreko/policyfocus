#!/bin/sh
# Refuse to push a red build.
#
# WHY THIS EXISTS. A commit was pushed with prebuild failing, because the push
# and the check ran in one command and the exit code was not read before the push
# went out. The gate had done its job and nobody looked. This makes that
# particular slip impossible rather than asking anybody to remember.
#
# WHAT IT RUNS. THE WHOLE CHAIN: prebuild, build, postbuild. Not prebuild alone,
# which is what it used to run and what let a failure through.
#
# WHY THE BUILD IS PART OF IT. Two gates read the pages the build writes rather
# than the sources they were built from -- check_anchor_text asks what a reader
# sees in a link, check_sitemap asks what the published sitemap asks to have
# indexed -- and neither can exist before `next build`. Running prebuild alone
# therefore exercised every gate EXCEPT the two that need a build, and a
# postbuild failure sat green locally and red on Vercel for as long as nobody
# ran a full build by hand. If a gate cannot run without a build, the build is
# part of the chain.
#
# IT IS SLOW ON PURPOSE, and it is slower now: prebuild is a couple of minutes,
# most of it check_links waiting politely on other people's servers, and the
# build is a couple more. That is the right trade against pushing something
# broken to a branch somebody else may build on, and the timing is printed at
# the end so the cost is visible rather than guessed at.
#
# AND A FAILURE HERE IS BLOCKING, whatever caused it. "Pre-existing" describes
# when a failure started, not whether it may be pushed over; a failure outside
# the branch's scope is reported and ruled on, never stepped around. See
# sources/scope.md, "A failure you observe is blocking".
#
# TO SKIP IT, deliberately and visibly:  git push --no-verify
# There are honest reasons — pushing a work-in-progress branch nobody builds, or
# a documentation-only change. There is no honest reason to make it the habit.
#
# INSTALL:  git config core.hooksPath .githooks
# Versioned rather than left in .git/hooks so it survives a fresh clone and can be
# reviewed in a diff like everything else here.

set -e

root=$(git rev-parse --show-toplevel)
# THE INTENT LIVES IN THE COMMON GIT DIRECTORY, NOT IN "$root/.git". In a linked
# worktree `.git` is a FILE pointing at the real directory, so "$root/.git/..."
# is a path through a file and the write fails with "Not a directory" — after
# the whole chain has run green, which is the worst possible moment to find out.
# This repository works in worktrees by default (see `git worktree list`), and
# every brief that asks for one was asking for a push this hook could not
# complete.
#
# COMMON RATHER THAN PER-WORKTREE, and that is the meaning rather than the
# convenience: the question the intent answers is "did the last push land on the
# remote", which is a fact about this repository and its remote and not about
# which worktree happened to issue it. A dropped push from one worktree should
# block the next push from any of them, which is exactly what the hook's own
# note says it wants.
intent="$(git rev-parse --git-common-dir)/eufabric-push-intent"

# WHAT THIS HOOK IS FOR, SECOND JOB. The first is not pushing a red build. The
# second is proving the ref actually moved, and it was missing until 21 September
# 2026, when two pushes of #77 ran the whole chain green and then died mid-pack —
# "send-pack: unexpected disconnect", "Connection to github.com closed by remote
# host" — leaving the branch not on the remote and the chain's green the only thing
# anybody had looked at. The third push went out with --no-verify, which is recorded
# as an exception taken in sources/dependency_docket.md, D-27, and is the temptation
# this check exists to remove.
#
# GIT HAS NO POST-PUSH HOOK, and a pre-push hook cannot observe its own push: by the
# time the pack is sent this script has exited. So the question is asked one push
# later — WAS THE LAST INTENT FULFILLED — and it is asked before anything else, so a
# dropped push blocks the next one instead of being discovered by somebody wondering
# where their branch went. A person who wants the answer NOW runs
# `.githooks/pre-push --verify-last`, which is this same check on its own.
# THE RETRY MUST NOT BE BLOCKED BY THE THING IT IS FIXING. `$1` is the list of refs
# this push is carrying; a dropped intent for one of THOSE is a push being made
# again, which is the remedy the message asks for, and it is announced rather than
# refused. A dropped intent for any OTHER ref blocks, because that branch is sitting
# on a green chain nobody sent and the next push is the last chance to say so.
verify_last() {
  carrying=$1
  [ -f "$intent" ] || { echo "pre-push: no push intent on file — nothing to verify."; return 0; }
  bad=0
  # `landed` is not the negation of `bad`. A retry of a ref this push is carrying is
  # allowed through without blocking, and it has NOT landed: clearing the intent on
  # the way past would throw away the record of a push that is still missing, and if
  # this retry drops too there would be nothing left to say so. The file is removed
  # only when every ref in it is on the remote at the sha it was pushed at.
  landed=1
  while read -r ref sha; do
    [ -n "$ref" ] || continue
    actual=$(git ls-remote origin "$ref" 2>/dev/null | awk '{print $1}')
    if [ "$actual" = "$sha" ]; then
      continue
    fi
    landed=0
    if printf '%s\n' "$carrying" | grep -qx -- "$ref"; then
      echo >&2
      echo "pre-push: THE LAST PUSH OF $ref DID NOT LAND — intended $sha, remote holds" >&2
      echo "pre-push: ${actual:-nothing}. This push is the retry, so it goes ahead." >&2
      echo >&2
      continue
    fi
    bad=1
    echo >&2
    echo "pre-push: THE LAST PUSH DID NOT LAND." >&2
    echo "pre-push:   ref      $ref" >&2
    echo "pre-push:   intended $sha" >&2
    echo "pre-push:   remote   ${actual:-(the ref does not exist on origin)}" >&2
    echo "pre-push: the gate chain passed and the pack did not arrive. Push it again." >&2
    echo "pre-push: if that ref is deliberately abandoned, rm $intent" >&2
    echo >&2
  done < "$intent"
  if [ "$landed" = 1 ]; then
    rm -f "$intent"
  fi
  [ "$bad" = 0 ] || return 1
  return 0
}

if [ "$1" = "--verify-last" ]; then
  verify_last ""
  exit $?
fi

# THE REFS THIS PUSH IS CARRYING, read from stdin before anything consumes it. git
# gives one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
refs=$(cat || true)

# The remote refs this push is carrying, one per line, for verify_last.
carrying=$(printf '%s\n' "$refs" | awk 'NF>=3 {print $3}')

verify_last "$carrying" || exit 1

# A RETRY OF THE SAME SHA DOES NOT RE-RUN THE CHAIN, AND THAT IS THE POINT OF
# RECORDING THE INTENT. The chain is a property of the TREE, not of the connection:
# if the intent on file names every ref this push is carrying at exactly the sha it
# is carrying, those gates have already passed for these bytes and running them
# again for nine minutes proves nothing. It was that nine minutes, three times over,
# that produced the --no-verify push of #77 (D-27) — so the rule keeps its teeth and
# the cost of an honest retry goes to nothing.
#
# ANY DIFFERENCE AND THE CHAIN RUNS: a different sha, a ref not in the intent, an
# intent file that is not there. An amended commit is a different tree and is
# checked like any other.
retry_of_a_checked_tree() {
  [ -f "$intent" ] || return 1
  [ -n "$refs" ] || return 1
  printf '%s\n' "$refs" | while read -r lref lsha rref rsha; do
    [ -n "$rref" ] || continue
    grep -qx -- "$rref $lsha" "$intent" || exit 1
  done
}

if retry_of_a_checked_tree; then
  echo "pre-push: the gate chain already passed for this exact tree — $(cat "$intent")"
  echo "pre-push: this is a retry of a push that did not land, so the chain is not run"
  echo "pre-push: again. Nothing here is skipped: the same gates passed on the same bytes."
  exit 0
fi
if [ ! -d "$root/web/node_modules" ]; then
  echo "pre-push: web/node_modules is missing — run npm install in web/ first." >&2
  echo "pre-push: refusing to push a build that cannot be checked." >&2
  exit 1
fi

log=/tmp/eufabric-prepush.log
started=$(date +%s)

# The whole chain in one call, because npm runs the three stages itself.
run_stage() {
  stage=$1
  if ! (cd "$root/web" && npm run --silent "$stage" >>"$log" 2>&1); then
    echo >&2
    echo "pre-push: THE GATE CHAIN FAILED. Nothing was pushed." >&2
    echo "pre-push: the log names the stage — prebuild, build or postbuild." >&2
    echo >&2
    tail -30 "$log" >&2
    echo >&2
    echo "pre-push: full output in $log" >&2
    exit 1
  fi
}

: >"$log"
echo "pre-push: running the whole chain — prebuild, build, postbuild (a few minutes)…"
# ONE COMMAND, THREE STAGES. npm's own lifecycle runs `prebuild` before `build`
# and `postbuild` after it, so naming them here would run prebuild twice and add
# two minutes for nothing. What makes this the whole chain is that `build` is
# what is asked for; what made the old hook partial is that `prebuild` was.
run_stage build

# THE LOCAL-ONLY CHECKS, AFTER THE CHAIN AND DELIBERATELY OUTSIDE IT.
#
# These need openpyxl or a gitignored cache body, and neither exists in the build
# image. Putting them in `npm run build` is what broke production at d96903a: the
# gate read the Odenweller workbooks, passed on every developer machine, and failed
# on Vercel where the package and the bytes are both absent.
#
# So the split is by what a step needs, not by what it checks. A step that reads only
# tracked files belongs in prebuild, where Vercel runs it too. A step that needs
# something outside the build image belongs here, where the machine that has those
# things is the one that runs it. See sources/scope.md, "A build-time gate reads
# tracked files only".
#
# EACH ONE PASSES QUIETLY ON A MACHINE THAT LACKS ITS INPUTS, because a contributor
# without the workbooks is still entitled to push.
#
# check_build_image IS THE RULE MADE MECHANICAL. It unpacks `git archive HEAD` into a
# temporary tree -- tracked files and nothing else, which is what a deployment checks
# out -- blocks every third-party package requirements-gates.txt does not name, and
# runs the prebuild chain there. It adds about forty seconds and it is the only thing
# that will catch the next step that reaches for a workbook; scope.md's rule is prose,
# and prose does not fail a push.
#
# A CHECK MAY TAKE ARGUMENTS, so they are run through a function rather than
# a bare loop: build_leadit_entries wants --check.
run_local() {
  name=$1; shift
  if ! python3 "$root/sources/$name.py" "$@" >>"$log" 2>&1; then
    echo >&2
    echo "pre-push: $name FAILED. Nothing was pushed." >&2
    echo >&2
    tail -20 "$log" >&2
    echo >&2
    echo "pre-push: full output in $log" >&2
    exit 1
  fi
}

run_local check_hydrogen_workbook
# The second list's workbook, for the same reason and by the same shape: openpyxl and a
# gitignored 8.8 MB xlsx. sources/leadit_entries.json is the tracked derived file, this
# recomputes it from the workbook entry by entry, and build_steel_second_list.py checks
# its recorded hash against benchmark_snapshots.json inside the build.
run_local build_leadit_entries --check
# The byte-level half of the citation gate. Reporting-only today — see L7 in
# sources/ladder_questions.json — and here rather than in the build because the
# cache bodies are gitignored.
run_local check_citation_bodies
run_local check_build_image

echo "pre-push: gate chain green — prebuild, build and postbuild, $(( $(date +%s) - started ))s."
echo "pre-push: local-only checks green — check_hydrogen_workbook, build_leadit_entries --check,\n  check_citation_bodies, check_build_image."

# THE INTENT, WRITTEN LAST. One line per ref this push is about to move, and it is
# written only after the chain has passed, so the file never claims an intent the
# gates refused. A deletion (an all-zero local sha) moves nothing and is skipped.
: >"$intent"
printf '%s\n' "$refs" | while read -r lref lsha rref rsha; do
  [ -n "$rref" ] || continue
  case "$lsha" in
    *[!0]*) printf '%s %s\n' "$rref" "$lsha" >>"$intent" ;;
  esac
done
if [ -s "$intent" ]; then
  echo "pre-push: intent recorded — the next push verifies that these landed:"
  sed 's/^/  /' "$intent"
fi
