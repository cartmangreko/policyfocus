# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Secrets / credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*secret*

# Claude Code local (machine-specific) settings — settings.json (shared) is still tracked
.claude/settings.local.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts / caches
dist/
build/
.cache/
*.log

# The seeded design canvas: ~2 MB of editor payload wrapped around the artboards
# next to it. The artboards and canvas.json ARE the source and are tracked; this
# file is rebuilt from them by the design skill's seeder on every change, and
# the published copy lives at the artifact URL.
docs/design/canvas/*.html
!docs/design/canvas/*.dc.html
