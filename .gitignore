# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Secrets / credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*secret*

# Claude Code local (machine-specific) settings — settings.json (shared) is still tracked
.claude/settings.local.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts / caches
dist/
build/
.cache/
*.log

# The seeded design canvas: ~2 MB of editor payload wrapped around the artboards
# next to it. The artboards and canvas.json ARE the source and are tracked; this
# file is rebuilt from them by the design skill's seeder on every change, and
# the published copy lives at the artifact URL.
docs/design/canvas/*.html
!docs/design/canvas/*.dc.html

# Analysis artefacts and exploratory one-off outputs — sources/hidden_share.py,
# sources/export_status_history.py and friends. Nothing on the site reads what
# they write, which is why none of it is tracked.
scratch/

# The hydrogen benchmark inputs, fetched by sources/build_hydrogen_benchmark.py.
# NOT COMMITTED ON PURPOSE: the content of both files is the IEA's Hydrogen
# Projects Database — directly in one case, quality-checked by Odenweller and
# Ueckerdt in the other — and this repository is not licensed to redistribute it.
# The script fetches them from the publishers on first run and the ids on the
# rows are what makes the comparison reproducible without a copy living here.
sources/cache/hydrogen/
