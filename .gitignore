# OS / editor junk
.DS_Store
Thumbs.db
*.swp

# Secrets / credentials — never commit
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*secret*

# Claude Code local (machine-specific) settings — settings.json (shared) is still tracked
.claude/settings.local.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts / caches
dist/
build/
.cache/
*.log
